{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": true,
        "meta": {
          ".write": "newData.exists()",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "splitsEnabled": { ".validate": "newData.isBoolean()" },
          "resultsHidden": { ".validate": "newData.isBoolean()" },
          "team": { ".validate": "newData.isString() && newData.val().length === 6 && (!data.exists() || newData.val() === data.val()) && root.child('teams/' + newData.val() + '/meta').exists()" },
          "$other": { ".validate": false }
        },
        "roster": {
          ".write": true,
          "$key": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" }
        },
        "stamps": {
          "$stamp": {
            ".write": "newData.exists()",
            ".validate": "newData.hasChildren(['type', 'epoch_ms'])",
            "type": { ".validate": "(newData.val() === 'START' || newData.val() === 'FINISH' || newData.val() === 'SPLIT') && (!data.exists() || newData.val() === data.val())" },
            "epoch_ms": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "athlete": { ".validate": "newData.isString()" },
            "operator": { ".validate": "newData.isString()" },
            "note": { ".validate": "newData.isString()" },
            "editedAt": { ".validate": "newData.isNumber()" },
            "time": { ".validate": "newData.isString()" },
            "date": { ".validate": "newData.isString()" },
            "iso": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "roomIndex": {
      ".read": true,
      "$code": {
        ".write": "newData.exists() && !root.child('rooms/' + $code + '/meta/team').exists()",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "resultsHidden": { ".validate": "newData.isBoolean()" },
        "lastActivityAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "teamIndex": {
      ".read": true,
      "$id": {
        ".write": "newData.exists()",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "deleted": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "teams": {
      "$team": {
        ".read": true,
        "meta": {
          ".write": "newData.exists()",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "deleted": { ".validate": "newData.isBoolean()" },
          "indexId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30 && (!data.exists() || newData.val() === data.val())" },
          "$other": { ".validate": false }
        },
        "rooms": {
          "$code": {
            ".write": "newData.exists()",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "deleted": { ".validate": "newData.isBoolean()" },
            "lastActivityAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
